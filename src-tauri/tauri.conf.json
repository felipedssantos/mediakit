{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaKit",
  "version": "0.3.0",
  "identifier": "com.feliped.mediakit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MediaKit",
        "width": 1920,
        "height": 1080,
        "center": true,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "theme": "Dark"
      },
      {
        "label": "snip-overlay",
        "title": "Selecionar área",
        "url": "index.html?snip=1",
        "width": 400,
        "height": 300,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost snip: http://snip.localhost https: data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/screenshots/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe", "binaries/yt-dlp"]
  }
}
