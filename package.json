{
  "name": "conversor",
  "private": true,
  "version": "0.1.0",
  "description": "Windows desktop app for local video/image conversion and media downloads",
  "author": "Felipe Dumont",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipedssantos/conversor.git"
  },
  "packageManager": "npm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node ./scripts/with-cargo.mjs tauri",
    "ffmpeg:download": "powershell -ExecutionPolicy Bypass -File ./scripts/download-ffmpeg.ps1",
    "ytdlp:download": "powershell -ExecutionPolicy Bypass -File ./scripts/download-ytdlp.ps1"
  },
  "dependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/chivo-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-react": "^1.41.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
